{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 150,
      "excludeFiles": "{node_modules/**,.next/**,src/**,public/**,backend/.venv/**,**/__pycache__/**,*.md}"
    }
  }
}
